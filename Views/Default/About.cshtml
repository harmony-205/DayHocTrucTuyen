@{
    ViewBag.Title = "Thông tin - Dạy Học Trực Tuyến";
    ViewBag.ThongTin = "active";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main id="main">
    <!-- ======= Breadcrumbs ======= -->
    <div class="breadcrumbs" data-aos="fade-in">
        <div class="container">
            <h2>Thông tin về chúng tôi</h2>
            <p>Dạy Học Trực Tuyến là nền tảng kết nối giảng viên và học viên thông minh, hiện đại, mang lại trải nghiệm học tập và tương tác trực quan, hiệu quả.</p>
        </div>
    </div><!-- End Breadcrumbs -->

    <!-- ======= About Section ======= -->
    <section id="about" class="about">
        <div class="container" data-aos="fade-up">
            <div class="row">
                <div class="col-lg-6 order-1 order-lg-2" data-aos="fade-left" data-aos-delay="100">
                    <img src="~/Content/Img/Resources/about.jpg" class="img-fluid" alt="Về chúng tôi">
                </div>
                <div class="col-lg-6 pt-4 pt-lg-0 order-2 order-lg-1 content">
                    <h3>Niềm hạnh phúc lớn lao nhất của chúng tôi chính là mang đến hạnh phúc cho bạn.</h3>
                    <p class="fst-italic">
                        Hãy mang những muộn phiền của bạn đến đây, chúng tôi sẽ biến nó thành niềm vui cho bạn. Không gì hạnh phúc và vui sướng hơn là được học tập và làm việc trong một môi trường năng động và tràn đầy sức sống.
                    </p>
                    <ul>
                        <li><i class="bi bi-check-circle"></i> Môi trường thân thiện, tràn đầy năng lượng tích cực.</li>
                        <li><i class="bi bi-check-circle"></i> Đội ngũ tư vấn chuyên nghiệp, tận tình giúp đỡ khi bạn gặp khó khăn.</li>
                        <li><i class="bi bi-check-circle"></i> Kết nối, giao lưu với bạn bè trên mọi miền đất nước.</li>
                    </ul>
                    <p>
                        Hãy đến với chúng tôi, nơi đây luôn có những thứ bạn cần và luôn có những người quan tâm bạn mọi lúc mọi nơi!
                    </p>
                </div>
            </div>
        </div>
    </section><!-- End About Section -->

    <!-- ======= Counts Section ======= -->
    <section id="counts" class="counts section-bg">
        <div class="container">
            <div class="row counters">
                <div class="col-lg-3 col-6 text-center">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.Courses" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Khóa học</p>
                </div>
                <div class="col-lg-3 col-6 text-center">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.TV" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Thành viên</p>
                </div>
                <div class="col-lg-3 col-6 text-center">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.GV" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Giáo viên</p>
                </div>
                <div class="col-lg-3 col-6 text-center">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.HS" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Học sinh</p>
                </div>
            </div>
        </div>
    </section><!-- End Counts Section -->

    <!-- ======= Why Us Section ======= -->
    <section id="why-us" class="why-us">
        <div class="container" data-aos="fade-up">
            <div class="row">
                <div class="col-lg-4 d-flex align-items-stretch">
                    <div class="content">
                        <h3>Lý do chọn Dạy Học Trực Tuyến?</h3>
                        <p>
                            Môi trường tươi trẻ, thân thiện. Sử dụng công nghệ và kỹ thuật tiên tiến trong quá trình giảng dạy. Có đội ngũ giáo viên có trình độ chuyên môn cao.
                            Có chế độ chăm sóc khách hàng chất lượng cao, luôn đặt trải nghiệm và cảm xúc của khách hàng lên hàng đầu.
                        </p>
                        <div class="text-center">
                            <a href="~/account/register" class="more-btn">Đăng ký ngay <i class="bx bx-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8 d-flex align-items-stretch" data-aos="zoom-in" data-aos-delay="100">
                    <div class="icon-boxes d-flex flex-column justify-content-center">
                        <div class="row">
                            <div class="col-xl-4 d-flex align-items-stretch">
                                <div class="icon-box mt-4 mt-xl-0">
                                    <i class="bx bx-book-heart"></i>
                                    <h4>Môi trường học tập</h4>
                                    <p>Tươi trẻ, năng động với đội ngũ giáo viên có trình độ chuyên môn cao.</p>
                                </div>
                            </div>
                            <div class="col-xl-4 d-flex align-items-stretch">
                                <div class="icon-box mt-4 mt-xl-0">
                                    <i class="bx bx-shield-alt-2"></i>
                                    <h4>Phòng thi</h4>
                                    <p>Chuyên nghiệp, hỗ trợ toàn diện với chế độ bảo mật cao.</p>
                                </div>
                            </div>
                            <div class="col-xl-4 d-flex align-items-stretch">
                                <div class="icon-box mt-4 mt-xl-0">
                                    <i class="bx bx-donate-heart"></i>
                                    <h4>Nhân viên</h4>
                                    <p>Thân thiện, luôn luôn lắng nghe ý kiến khách hàng và sẵn sàng thay đổi.</p>
                                </div>
                            </div>
                        </div>
                    </div><!-- End .content-->
                </div>
            </div>
        </div>
    </section><!-- End Why Us Section -->
</main>
